<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Only allow our domain (redundant with WebView logic but defense-in-depth) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">itcaretv.top</domain>
    </domain-config>
</network-security-config>
